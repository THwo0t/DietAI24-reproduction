# Copy to .env in this demo root, fill locally, then chmod 600 .env.
# Never commit, archive, paste or publish the filled file.
OPENAI_BASE_URL=https://api.zicc.cc/v1
EMBEDDING_BASE_URL=https://api.openai.com/v1
CHAT_MODEL=gpt-6.1-sol
VISION_MODEL=gpt-6.1-sol
OPENAI_API_KEY=replace_with_local_zicc_credential
EMBEDDING_API_KEY=replace_with_local_official_embedding_credential
